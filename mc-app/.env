ENABLE_NEW_JSX_TRANSFORM="true"
FAST_REFRESH="true"

# Local development only, and deliberately placeholders. A deployed
# application gets these from the Connect deployment configuration, which
# takes precedence over anything in this file.
#
# ENTRY_POINT_URI_PATH must match the Custom Application registration
# exactly: the permission keys are derived from it, so a mismatch produces
# an application that loads and then refuses every user.
CUSTOM_APPLICATION_ID="local-development"
ENTRY_POINT_URI_PATH="abandoned-carts"
CLOUD_IDENTIFIER="gcp-us"
APPLICATION_URL="https://your_app_hostname.com"
INITIAL_PROJECT_KEY="your-project-key"
ABANDONED_CART_SERVICE_URL="http://localhost:8080"
