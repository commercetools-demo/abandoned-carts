# CommerceTools API Configuration
# Required for connecting to CommerceTools API
CTP_CLIENT_ID=your_client_id_here_24_chars
CTP_CLIENT_SECRET=your_client_secret_here_32_chars
CTP_PROJECT_KEY=your_project_key_here
CTP_SCOPE=manage_project:your_project_key
CTP_REGION=europe-west1.gcp

# SMTP Email Configuration
# Required for sending emails via SMTP
EXTENSION_SMTP_CLIENT_HOST=
EXTENSION_SMTP_ENCRYPTION=tls
EXTENSION_SMTP_HOST=smtp.eu.mailgun.org
EXTENSION_SMTP_PASSWORD=your_encrypted_password_here
EXTENSION_SMTP_PORT=587
EXTENSION_SMTP_SENDER=no-reply@frontend.commercetools.com
EXTENSION_SMTP_USER=demo-mails@frontend.commercetools.com