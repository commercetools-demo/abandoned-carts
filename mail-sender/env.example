# CommerceTools API Configuration
# Required for connecting to CommerceTools API
CTP_CLIENT_ID=your_client_id_here_24_chars
CTP_CLIENT_SECRET=your_client_secret_here_32_chars
CTP_PROJECT_KEY=your_project_key_here
CTP_SCOPE=manage_project:your_project_key
CTP_REGION=europe-west1.gcp

# SendGrid Email Configuration
# Required for sending emails via SendGrid API
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_MAIL_FROM=no-reply@frontend.commercetools.com